# Application Settings
APP_NAME="NiFi Monitoring Dashboard"
DEBUG=true

# Database - SQLite for Phase 1 (demo), PostgreSQL for Phase 2 (production)
# Phase 1 (SQLite - default):
DATABASE_URL=sqlite+aiosqlite:///./nifi_monitoring.db

# Phase 2 (PostgreSQL - uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nifi_monitoring

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Data
SEED_DEMO_DATA=true
